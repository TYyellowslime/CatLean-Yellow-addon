{
  "schemaVersion": 1,
  "id": "yellow_catlean_addon",
  "version": "${version}",
  "name": "Yellow CatLean Addon",
  "description": "Additional modules and Neuro rotation support for CatLean on Minecraft 26.2.",
  "environment": "client",
  "mixins": [
    "yellow-catlean-addon.mixins.json"
  ],
  "entrypoints": {
    "catlean": [
      "su.catlean.yellow.YellowAddon"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-language-kotlin": ">=1.14.0",
    "fabric-api": ">=0.152.1"
  }
}
